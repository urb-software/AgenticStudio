# Design system export (Claude Design): keep files byte-identical to the export so re-exports diff cleanly.
# The hand-written files in it stay formatted. A `!` rule cannot re-include a file whose parent
# directory is ignored, so ignore directory contents (`dir/*`), never the directory itself.
design-system/*
!design-system/serve.mjs
!design-system/serve.test.mjs
!design-system/HOW-TO-RUN.md
design-system/prototype/*
!design-system/prototype/
!design-system/prototype/support.js

# Owned copy of design-system/code/globals.css: kept byte-identical to the export so a re-export
# re-syncs by plain diff (docs/architecture/frontend.md, "Styling and UI components").
apps/web/src/app/globals.css
