# Copy to .env for local development (cp .env.example .env); .env is git-ignored.
# Every value here is a dev-only placeholder, not a credential.

# --- Docker Compose (compose.yaml) ---
COMPOSE_PROJECT_NAME=agentic-studio
POSTGRES_DB=agentic_studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API (apps/api, validated by platform/config) and Prisma (packages/database) ---
# DATABASE_URL must match the Compose values above.
DATABASE_URL=postgresql://studio:studio_dev_only@localhost:5432/agentic_studio
API_PORT=3001
# Bind address: localhost only by default. Set it explicitly in a deployment.
API_HOST=127.0.0.1
REDIS_URL=redis://localhost:6379
# The only origin accepted on mutations; the web app's URL. https makes the cookie Secure.
STUDIO_ORIGIN=http://localhost:3000
# Comma-separated IPs/CIDRs whose X-Forwarded-For is trusted for the client IP (empty = none).
API_TRUSTED_PROXIES=
# Required. Argon2id hash of the operator password, never the password itself. Generate it with
#   pnpm --filter @agentic-studio/api run auth:hash-password
# and paste it in single quotes: STUDIO_OPERATOR_PASSWORD_HASH='$argon2id$v=19$...'
STUDIO_OPERATOR_PASSWORD_HASH=
