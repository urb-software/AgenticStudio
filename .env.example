# Copy to .env for local development (cp .env.example .env); .env is git-ignored.
# Every value here is a dev-only placeholder, not a credential.

# --- Docker Compose (compose.yaml) ---
COMPOSE_PROJECT_NAME=agentic-studio
POSTGRES_DB=agentic_studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API (apps/api, validated by platform/config) and Prisma (packages/database) ---
# DATABASE_URL must match the Compose values above.
DATABASE_URL=postgresql://studio:studio_dev_only@localhost:5432/agentic_studio
API_PORT=3001
# Bind address: localhost only by default. Set it explicitly in a deployment.
API_HOST=127.0.0.1
REDIS_URL=redis://localhost:6379
# The only origin accepted on mutations; the web app's URL. https makes the cookie Secure.
STUDIO_ORIGIN=http://localhost:3000
# Comma-separated IPs/CIDRs whose X-Forwarded-For is trusted for the client IP (empty = none).
API_TRUSTED_PROXIES=
# Required. Argon2id hash of the operator password, never the password itself. Generate it with
#   pnpm --filter @agentic-studio/api run auth:hash-password
# and paste it in single quotes: STUDIO_OPERATOR_PASSWORD_HASH='$argon2id$v=19$...'
STUDIO_OPERATOR_PASSWORD_HASH=
# Required. Data directory for repository data (Clones): an absolute path outside the repository,
# e.g. ~/.local/share/agentic-studio (write it out in full). It must exist and be writable, and
# (outside Windows) contain only letters, digits and . _ / - (no spaces).
# Repository features run on Linux only.
STUDIO_DATA_DIR=
# Required. Master key of the secret store: 32 random bytes, base64. Never commit a real key.
# Generate one with either command and paste the output here (README.md, "Secrets key"):
#   openssl rand -base64 32
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Losing it makes stored secrets unrecoverable; back it up separately from the database.
STUDIO_SECRETS_KEY=

# Optional. Git hosts Studio trusts over SSH without asking (private repositories, Deploy keys):
# standard known_hosts lines ("<host>[,<host>] <key type> <base64 key>", [host]:port for a port
# other than 22). Empty trusts no host: Studio then shows each host's key fingerprint and asks the
# operator to confirm it. Copy the lines from the provider's official page, never from a scan:
#   GitHub:    https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/githubs-ssh-key-fingerprints
#              (or the ssh_keys list of https://api.github.com/meta)
#   GitLab:    https://docs.gitlab.com/user/gitlab_com/#ssh-known_hosts-entries
#   Bitbucket: https://support.atlassian.com/bitbucket-cloud/docs/configure-ssh-and-two-step-verification/
# Several lines: one per line inside double quotes, or separated by a literal \n on one line.
# Blank lines and # comments inside the value are ignored. README.md, "Trusted SSH hosts".
STUDIO_SSH_KNOWN_HOSTS=
# Git remotes on loopback and private addresses (a self-hosted Git server on your LAN): true or
# false (default). Link-local and cloud metadata addresses are always refused. README.md,
# "Remote address policy".
STUDIO_GIT_ALLOW_PRIVATE_REMOTES=false
# Optional. Token of the agent worker (worker routes under /api/worker/): at least 32 characters,
# e.g. `openssl rand -base64 32`. Put the same value in the agent worker's own
# apps/agent-worker/.env (see apps/agent-worker/.env.example); the worker never reads this file.
# Empty rejects every worker route. Never commit a real token.
STUDIO_WORKER_TOKEN=
# Seconds a claimed Run may go without a worker heartbeat before it fails as worker_lost (10-3600).
STUDIO_WORKER_LEASE_SECONDS=60
# Optional. Token of the environment controller (controller routes under /api/controller/): at
# least 32 characters and never the worker token, e.g. `openssl rand -base64 32`. Put the same
# value in the controller's own .env; the controller never reads this file. Empty rejects every
# controller route. Never commit a real token.
STUDIO_CONTROLLER_TOKEN=
# Seconds a claimed Preview operation may go without a controller report before it fails as
# controller_lost (10-3600).
STUDIO_CONTROLLER_LEASE_SECONDS=60
# Limits copied onto each Preview build when it is requested: memory in MiB (128-65536), processor
# in percent of one core (10-6400), tasks (64-32768) and build time in minutes (1-120).
STUDIO_PREVIEW_MEMORY_MB=1024
STUDIO_PREVIEW_CPU_PERCENT=100
STUDIO_PREVIEW_TASKS_MAX=512
STUDIO_PREVIEW_BUILD_MINUTES=20
# Cap on a Preview operation's stored log, in bytes (64 KiB-1 GiB; default 2 MiB). At the cap one
# "log truncated" line is stored and later output is dropped.
STUDIO_PREVIEW_LOG_MAX_BYTES=2097152
# Minutes a requested Preview operation may wait for a controller before it fails as not_claimed
# (1-1440; default 5). It applies only while no controller has been seen for a lease or longer.
STUDIO_PREVIEW_UNCLAIMED_MINUTES=5
# The most Previews that run at the same time (1-50; default 3). A Project takes a place while its
# Preview runs or a build of it is requested or claimed; a rebuild of a running Preview keeps its place.
STUDIO_PREVIEW_MAX_RUNNING=3
# Run limits (Issue #100), copied onto each Run when it starts and shown on the Run page: the
# longest a Run step may work in minutes (1-1440), the most Run steps a Run, and each of its
# Follow-ups, may take (1-100), the days a Run may wait for the operator before Studio cancels it
# (1-365), and the Run steps a Run may take in total before it accepts no Follow-up (Issue #141).
STUDIO_RUN_STEP_MINUTES=60
STUDIO_RUN_MAX_STEPS=10
STUDIO_RUN_WAITING_DAYS=14
STUDIO_RUN_MAX_TOTAL_STEPS=50
# Cap on a Run's stored log, in bytes of event text (64 KiB-1 GiB; default 8 MiB). At the cap one
# "log truncated" entry is stored and later output is dropped; the Run continues.
STUDIO_RUN_LOG_MAX_BYTES=8388608
# Days a Run's Environment file snapshot (its log redaction values) is kept while its failed
# delivery can be retried (1-90; default 7).
STUDIO_RUN_SNAPSHOT_RETENTION_DAYS=7
# Issue #146: your own GitHub login. Review comments you wrote on a Run's pull request are
# selected when you load them on the Run page; everyone else's are not. Exact, case-insensitive;
# empty selects none.
STUDIO_OPERATOR_GITHUB_LOGIN=
# Optional. The Merge credential: a fine-grained token of your own GitHub account, limited to the
# managed Repositories, with write access to Pull requests and Contents (one line, no spaces,
# 20-255 characters). Studio uses it only for your merge or close. Empty turns merging off.
# Never commit a real token.
STUDIO_MERGE_TOKEN=
# Optional. The domain Previews are served under, e.g. preview.example.test (never Studio's own
# hostname or a name under it). Empty shows no Preview hostname.
STUDIO_PREVIEW_DOMAIN=
# Working copy retention on the agent side (Issue #143; Studio decides, the agent worker removes).
# A finished Run without a pull request keeps its Working copy STUDIO_RETENTION_DAYS (0-3650) days
# from its result, and at most STUDIO_RETENTION_MAX_PER_PROJECT (0-1000) such Runs per Project keep
# it. A Run with a pull request keeps it until STUDIO_RETENTION_OPEN_PR_IDLE_DAYS (1-3650) days
# without activity on the Run (a Run step, an Answer or a Follow-up) or
# STUDIO_RETENTION_AFTER_PR_END_HOURS (0-8760) hours after the pull request was merged or closed,
# whichever is first; the limit never removes such a Run. Defaults: 7, 10, 30, 24.
STUDIO_RETENTION_DAYS=7
STUDIO_RETENTION_MAX_PER_PROJECT=10
STUDIO_RETENTION_OPEN_PR_IDLE_DAYS=30
STUDIO_RETENTION_AFTER_PR_END_HOURS=24

# --- Web (apps/web): the /api rewrite; rules in README.md, "Web /api proxy" ---
API_ORIGIN=http://localhost:3001
# Production opt-in for the rewrite (true | false); `next dev` always rewrites.
STUDIO_WEB_API_PROXY=false
