# Copy to .env for local development (cp .env.example .env); .env is git-ignored.
# Every value here is a dev-only placeholder, not a credential.

# --- Docker Compose (compose.yaml) ---
COMPOSE_PROJECT_NAME=agentic-studio
POSTGRES_DB=agentic_studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API (apps/api, validated by platform/config) and Prisma (packages/database) ---
# DATABASE_URL must match the Compose values above.
DATABASE_URL=postgresql://studio:studio_dev_only@localhost:5432/agentic_studio
API_PORT=3001
# Bind address: localhost only by default. Set it explicitly in a deployment.
API_HOST=127.0.0.1
REDIS_URL=redis://localhost:6379
# The only origin accepted on mutations; the web app's URL. https makes the cookie Secure.
STUDIO_ORIGIN=http://localhost:3000
# Comma-separated IPs/CIDRs whose X-Forwarded-For is trusted for the client IP (empty = none).
API_TRUSTED_PROXIES=
# Required. Argon2id hash of the operator password, never the password itself. Generate it with
#   pnpm --filter @agentic-studio/api run auth:hash-password
# and paste it in single quotes: STUDIO_OPERATOR_PASSWORD_HASH='$argon2id$v=19$...'
STUDIO_OPERATOR_PASSWORD_HASH=
# Required. Data directory for repository data (Clones): an absolute path outside the repository,
# e.g. ~/.local/share/agentic-studio (write it out in full). It must exist and be writable, and
# (outside Windows) contain only letters, digits and . _ / - (no spaces).
# Repository features run on Linux only.
STUDIO_DATA_DIR=
# Required. Master key of the secret store: 32 random bytes, base64. Never commit a real key.
# Generate one with either command and paste the output here (README.md, "Secrets key"):
#   openssl rand -base64 32
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Losing it makes stored secrets unrecoverable; back it up separately from the database.
STUDIO_SECRETS_KEY=

# Optional. Git hosts Studio trusts over SSH without asking (private repositories, Deploy keys):
# standard known_hosts lines ("<host>[,<host>] <key type> <base64 key>", [host]:port for a port
# other than 22). Empty trusts no host: Studio then shows each host's key fingerprint and asks the
# operator to confirm it. Copy the lines from the provider's official page, never from a scan:
#   GitHub:    https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/githubs-ssh-key-fingerprints
#              (or the ssh_keys list of https://api.github.com/meta)
#   GitLab:    https://docs.gitlab.com/user/gitlab_com/#ssh-known_hosts-entries
#   Bitbucket: https://support.atlassian.com/bitbucket-cloud/docs/configure-ssh-and-two-step-verification/
# Several lines: one per line inside double quotes, or separated by a literal \n on one line.
# Blank lines and # comments inside the value are ignored. README.md, "Trusted SSH hosts".
STUDIO_SSH_KNOWN_HOSTS=

# --- Web (apps/web): the /api rewrite; rules in README.md, "Web /api proxy" ---
API_ORIGIN=http://localhost:3001
# Production opt-in for the rewrite (true | false); `next dev` always rewrites.
STUDIO_WEB_API_PROXY=false
