{
  "name": "@agentic-studio/agent-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentic-studio/agent-definitions": "workspace:*",
    "@agentic-studio/contracts": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@agentic-studio/database": "workspace:*",
    "@agentic-studio/testing": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
