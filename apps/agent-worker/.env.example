# Agent worker settings (apps/agent-worker, Linux only). Copy to apps/agent-worker/.env
# (cp .env.example .env inside apps/agent-worker); .env is git-ignored. The worker reads only
# this file, never Studio's root .env: it must hold no database, Redis, secret-store or
# operator credentials, and refuses to start if any of them is in its environment.

# Where the worker reaches the Studio API. The worker always calls Studio; nothing calls it.
STUDIO_API_URL=http://localhost:3001
# The same value as the API's STUDIO_WORKER_TOKEN (copy the value, never share the file):
# at least 32 characters, e.g. `openssl rand -base64 32`. Never commit a real token.
STUDIO_WORKER_TOKEN=
# Pause between claims when idle, and heartbeat interval while carrying a Run (keep it well
# under the API's STUDIO_WORKER_LEASE_SECONDS).
STUDIO_WORKER_POLL_MS=5000
STUDIO_WORKER_HEARTBEAT_MS=10000

# How Runs are carried out: `cli` (default) starts the provider's official CLI; `fake` uses the
# scripted fake runner (no CLI, no network). The environment is production unless set to
# development or test, and the worker refuses to start with the fake runner in production.
STUDIO_WORKER_RUNNER=cli
STUDIO_WORKER_ENVIRONMENT=production

# Provider switches (operator only, docs/engineering/security.md §2). Both off by default; only
# the exact value `true` turns one on, anything else is off. Turn one on only after the
# provider's compliance record is Approved and still applicable, then restart the worker.
CLAUDE_CODE_ENABLED=false
CODEX_CLI_ENABLED=false

# The provider CLI binaries the worker starts (only through its spawn boundary, only for a
# provider whose switch is on): a command name on PATH or an absolute path, nothing else.
CLAUDE_CODE_BIN=claude
CODEX_CLI_BIN=codex
