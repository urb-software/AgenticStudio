    "/api/projects/{id}/repository": {
      "get": {
        "operationId": "getRepository",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Repository_Output"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project (urn:agentic-studio:problem:project-not-found) or no repository (urn:agentic-studio:problem:no-repository)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": [
          "projects"
        ]
      },
      "post": {
        "description": "Connects a repository. A public one over HTTPS is stored as `connecting` and cloned in the background (poll `GET /api/projects/{id}/repository`). A private one over SSH (`git@host:owner/repo.git` or `ssh://`) gets a Deploy key generated for the project and is stored as `awaiting_key` with its `publicKey`: add the key on the Git host, then `POST /api/projects/{id}/repository/verify`. A `failed` repository is replaced by the new attempt (an SSH one keeps its Deploy key).",
        "operationId": "connectRepository",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectRepositoryRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Repository_Output"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project (urn:agentic-studio:problem:project-not-found)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The project already has a repository (urn:agentic-studio:problem:repository-already-connected), the remote is connected to another project (urn:agentic-studio:problem:remote-already-connected; field error on url), or an earlier connect or fetch is still running (urn:agentic-studio:problem:repository-busy)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Invalid url or integrationBranch (field errors)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "501": {
            "description": "The API host is not Linux (urn:agentic-studio:problem:unsupported-platform)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "The job queue is unavailable; the attempt is marked failed (generic problem)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": [
          "projects"
        ]
      },
      "delete": {
        "description": "Disconnects the repository: a running connect or fetch is cancelled, then Studio removes its Clone, the Deploy key and the pinned host key (when it has them) and the repository record. The project and the remote repository are untouched. 204 when everything was removed; 202 with the repository in `disconnecting` when some of it could not be removed yet (retried at start-up and by repeating this request). A running operation never blocks it.",
        "operationId": "disconnectRepository",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Cleanup is pending: the repository stays `disconnecting` until it completes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Repository_Output"
                }
              }
            }
          },
          "204": {
            "description": "Disconnected: nothing of the repository is left"
          },
          "404": {
            "description": "Unknown project (urn:agentic-studio:problem:project-not-found) or no repository (urn:agentic-studio:problem:no-repository)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "501": {
            "description": "The API host is not Linux (urn:agentic-studio:problem:unsupported-platform)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": [
          "projects"
        ]
      }
    },
    "/api/projects/{id}/repository/fetch": {
      "post": {
        "description": "Brings the Clone up to date with the remote in the background: answers at once with the repository in `fetching` (poll `GET /api/projects/{id}/repository`). Allowed when the repository is `ready`, or `failed` with a usable Clone (`hasClone`).",
        "operationId": "fetchRepository",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Repository_Output"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project (urn:agentic-studio:problem:project-not-found) or no repository (urn:agentic-studio:problem:no-repository)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "A connect or fetch is still running (urn:agentic-studio:problem:repository-busy), or there is no usable Clone to fetch into; use Retry (urn:agentic-studio:problem:no-usable-clone)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "501": {
            "description": "The API host is not Linux (urn:agentic-studio:problem:unsupported-platform)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "The job queue is unavailable; the repository keeps its previous state (generic problem)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": [
          "projects"
        ]
      }
    },
    "/api/projects/{id}/repository/verify": {
      "post": {
        "description": "\"Verify and clone\" for an SSH repository (`awaiting_key`, `awaiting_host_key`, or `failed` without a Clone: Retry, with the same Deploy key). A Git host listed in the server's trusted host keys, or whose key is pinned for this repository, is cloned at once: the answer is the repository in `connecting` (poll `GET /api/projects/{id}/repository`). For any other host, Studio first retrieves its host key: the answer is the repository in `awaiting_host_key` with `hostKeyFingerprint` (or in `failed` when the host cannot be reached), and the operator confirms by verifying again with `acceptHostKeyFingerprint`, which pins the key and starts the clone.",
        "operationId": "verifyRepository",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRepositoryRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Repository_Output"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project (urn:agentic-studio:problem:project-not-found) or no repository (urn:agentic-studio:problem:no-repository)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The repository is not waiting to be verified, or no host key awaits confirmation (urn:agentic-studio:problem:repository-not-verifiable), or an earlier operation is still finishing (urn:agentic-studio:problem:repository-busy)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Invalid body, or acceptHostKeyFingerprint does not match (field errors)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "501": {
            "description": "The API host is not Linux (urn:agentic-studio:problem:unsupported-platform)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "The job queue is unavailable; the attempt is marked failed (generic problem)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": [
          "projects"
        ]
      }
    }
  },
  "info": {
    "title": "AI Agent Studio API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponse_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "password"
        ]
      },
      "SessionResponse_Output": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "authenticated"
        ],
        "additionalProperties": false
      },
      "CreateProjectRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "Project_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "ProjectList_Output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project_Output"
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "RepositorySummary_Output": {
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/RepositoryState_Output"
          },
          "url": {
            "type": "string"
          },
          "integrationBranch": {
            "type": "string"
          }
        },
        "required": [
          "state",
          "url",
          "integrationBranch"
        ],
        "additionalProperties": false
      },
      "RepositoryState_Output": {
        "type": "string",
        "enum": [
          "awaiting_key",
          "awaiting_host_key",
          "connecting",
          "ready",
          "fetching",
          "failed",
          "disconnecting"
        ],
        "description": "awaiting_key: an SSH repository whose Deploy key (publicKey) the operator still has to add on the Git host, then verify; awaiting_host_key: the Git host is not trusted yet, and the operator has to confirm its host key fingerprint (hostKeyFingerprint) by verifying with acceptHostKeyFingerprint; connecting: the first Clone is being made; ready: the Clone is up to date as of lastFetchedAt; fetching: the Clone is being brought up to date; failed: the last operation failed (hasClone tells whether a usable Clone remains); disconnecting: the operator disconnected the repository and Studio is still removing its data (retried at start-up and on a repeated disconnect). Later stories add values; treat an unknown value as unavailable."
      },
      "ProjectDetail_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "repository": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RepositorySummary_Output"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "createdAt",
          "repository"
        ],
        "additionalProperties": false
      },
      "RepositoryFailure_Output": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/RepositoryFailureCode_Output"
          },
          "detail": {
            "type": "string"
          },
          "remoteDefaultBranch": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false
      },
      "RepositoryFailureCode_Output": {
        "type": "string",
        "enum": [
          "auth_failed",
          "host_unreachable",
          "host_key_mismatch",
          "repository_not_found",
          "branch_not_found",
          "timeout",
          "size_limit",
          "remote_not_allowed",
          "redirect_refused",
          "interrupted",
          "unknown"
        ],
        "description": "The fixed failure reason codes (Epic #55). remote_not_allowed: the remote host is or resolves to an address Studio does not connect to (Issue #69); redirect_refused: the remote answered with an HTTP redirect, which Studio does not follow; interrupted: the operation was cut off by a crash or a restart of Studio, not by the repository (Issue #72). Later versions may add values; treat an unknown value as a generic failure."
      },
      "Repository_Output": {
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/RepositoryState_Output"
          },
          "url": {
            "type": "string"
          },
          "integrationBranch": {
            "type": "string"
          },
          "hasClone": {
            "type": "boolean"
          },
          "headSha": {
            "type": "string"
          },
          "lastFetchedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "failure": {
            "$ref": "#/components/schemas/RepositoryFailure_Output"
          },
          "publicKey": {
            "type": "string"
          },
          "hostKeyFingerprint": {
            "type": "string"
          }
        },
        "required": [
          "state",
          "url",
          "integrationBranch",
          "hasClone"
        ],
        "additionalProperties": false
      },
      "ConnectRepositoryRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "integrationBranch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^(?!@$)(?![-/.])(?!.*(?:\\.\\.|\\/\\/|@\\{|\\/\\.|\\.lock\\/|\\.lock$|[/.]$))[^\\x00-\\x20\\x7f~^:?*[\\\\]+$"
          }
        },
        "required": [
          "url",
          "integrationBranch"
        ],
        "additionalProperties": false
      },
      "VerifyRepositoryRequest": {
        "type": "object",
        "properties": {
          "acceptHostKeyFingerprint": {
            "description": "The SHA256 fingerprint (`SHA256:…`) of the host key the operator confirmed; it must equal the `hostKeyFingerprint` of the `awaiting_host_key` repository exactly.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "correlationId"
        ]
      }
    }
  }
}
