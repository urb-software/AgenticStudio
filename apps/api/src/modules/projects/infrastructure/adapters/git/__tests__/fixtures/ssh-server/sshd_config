# Test-only sshd: public-key login for the `git` user, keys supplied by the test.
Port 22
HostKey /etc/ssh/test_host_ed25519_key
AuthorizedKeysFile /etc/ssh/authorized_keys/%u
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers git
AllowAgentForwarding no
AllowTcpForwarding no
X11Forwarding no
LogLevel VERBOSE
# The suites connect from one address many times, failing on purpose (auth_failed, host key
# mismatch, ssh-keyscan). OpenSSH 9.8+ penalizes such a source and then refuses it, which
# would fail later tests at random (#72); this server is a test fixture only.
PerSourcePenalties no
