# Throwaway SSH + Git server for the Git adapter's SSH tests (Issue #59), built at test time.
# Base image pinned by digest. Host and client keys are generated by the test and copied in
# when the container starts; no key material is committed.
FROM alpine:3.22@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f

# `git:*` unlocks the account without giving it a password: public-key login only.
RUN apk add --no-cache git openssh-server \
 && adduser -D -h /home/git -s /bin/sh git \
 && echo 'git:*' | chpasswd -e \
 && mkdir -p /etc/ssh/authorized_keys /srv/git \
 && git init --quiet --bare --initial-branch=main /srv/git/repo.git \
 && git init --quiet --initial-branch=main /tmp/work \
 && cd /tmp/work \
 && echo '# fixture' > README.md \
 && git add README.md \
 && git -c user.name=Fixture -c user.email=fixture@example.test commit --quiet -m fixture \
 && git push --quiet /srv/git/repo.git main \
 && rm -rf /tmp/work \
 && chown -R git:git /srv/git

COPY sshd_config /etc/ssh/sshd_config

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
