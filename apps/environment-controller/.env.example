# Environment controller settings (apps/environment-controller, Linux only). Copy to
# apps/environment-controller/.env; .env is git-ignored. The controller runs as the Preview user,
# reads only this file and refuses to start if a Studio-side or agent-side setting (DATABASE_URL,
# REDIS_URL, STUDIO_SECRETS_KEY, STUDIO_OPERATOR_PASSWORD_HASH, STUDIO_MERGE_TOKEN,
# POSTGRES_PASSWORD, STUDIO_WORKER_TOKEN) is in its environment.

# Where the controller reaches the Studio API. The controller always calls Studio.
STUDIO_API_URL=http://localhost:3001
# The same value as the API's STUDIO_CONTROLLER_TOKEN (copy the value, never share the file):
# at least 32 characters, e.g. `openssl rand -base64 32`. Never commit a real token.
STUDIO_CONTROLLER_TOKEN=

# production (default), development or test. The fake runtime and non-rootless Docker are
# refused in production.
STUDIO_CONTROLLER_ENVIRONMENT=production
# docker (default) drives the Preview user's rootless Docker through Compose; fake runs nothing.
STUDIO_CONTROLLER_RUNTIME=docker
# true (default): Docker is the Preview user's rootless daemon, and the egress rules and the
# socket bridge run inside its network namespace. false is for tests on a system Docker.
STUDIO_CONTROLLER_ROOTLESS=true

# Absolute directory owned by the Preview user, 0700: builds, source trees and desired states.
STUDIO_CONTROLLER_DATA_DIR=/home/preview/studio-controller
# Pause between claims when idle, and the heartbeat while carrying an operation (keep it well
# under the API's STUDIO_CONTROLLER_LEASE_SECONDS). Longest wait for one API call.
STUDIO_CONTROLLER_POLL_MS=5000
STUDIO_CONTROLLER_HEARTBEAT_MS=15000
STUDIO_CONTROLLER_REQUEST_TIMEOUT_MS=30000
# After a stop or a timeout a process gets SIGTERM and this many seconds before SIGKILL.
STUDIO_CONTROLLER_KILL_GRACE_SECONDS=10
# Free disk space (GiB) a build needs before its source is unpacked; below it: disk_full.
STUDIO_CONTROLLER_MIN_FREE_GB=2

# The build bound has no setting here: each build brings its limits from the API
# (STUDIO_PREVIEW_MEMORY_MB, STUDIO_PREVIEW_CPU_PERCENT, STUDIO_PREVIEW_BUILD_MINUTES). Before a
# build the controller runs `systemctl --user set-property --runtime preview-build.slice` with
# MemoryMax set to the memory, no swap and the CPU quota. The build steps run in that slice (the
# server setup makes it the rootless daemon's cgroup-parent), apart from the daemon itself.

# The proxy group that may connect to the Preview sockets, and the directory they live in. The
# group id must match PREVIEW_PROXY_GID of the server setup.
STUDIO_CONTROLLER_PROXY_GID=2003
STUDIO_CONTROLLER_PROXY_DIR=/run/preview-proxy
# The root-owned egress rules script (only its `verify` runs). Production refuses another path and a script not owned by root or writable by others.
STUDIO_CONTROLLER_EGRESS_RULES_BIN=/usr/local/lib/agentic-studio/preview-egress-rules

# Set by the systemd user unit, not edited here (shown for completeness): the Preview user's home
# and runtime directory, and its rootless daemon's socket, which must be
# unix://$XDG_RUNTIME_DIR/docker.sock.
# HOME=/home/preview
# XDG_RUNTIME_DIR=/run/user/2002
# DOCKER_HOST=unix:///run/user/2002/docker.sock
