# Studio's server configuration (Issue #107, docs/engineering/deployment.md). The setup script
# copies this template to /etc/agentic-studio/.env (root, 0600) when that file does not exist yet
# and never overwrites it. It writes no secret: the empty values below are filled in by the
# operator, as root, on the server. Never commit a filled-in copy.

# --- Compose (/opt/agentic-studio/compose.yaml) ---
COMPOSE_PROJECT_NAME=agentic-studio
POSTGRES_DB=agentic_studio
POSTGRES_USER=studio
# Required. The database password, used only inside Studio's container network:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
# Required. Redis's password (requirepass), used only inside Studio's container network:
#   openssl rand -hex 32
REDIS_PASSWORD=
# Studio's container network and the fixed addresses of its services on it. The setup script's
# firewall rule blocks the agent user from this subnet except the reverse proxy's worker port, the
# API trusts X-Forwarded-For from the proxy's address only, and the boundary checks probe these
# addresses. Containers without a fixed address get one from the dynamic range. Change them only
# together with the matching settings at the top of setup-server.sh and check-boundary.sh.
STUDIO_NETWORK_SUBNET=172.31.250.0/24
STUDIO_NETWORK_DYNAMIC_RANGE=172.31.250.128/25
STUDIO_POSTGRES_ADDRESS=172.31.250.10
STUDIO_REDIS_ADDRESS=172.31.250.11
STUDIO_API_ADDRESS=172.31.250.12
STUDIO_WEB_ADDRESS=172.31.250.13
STUDIO_PROXY_ADDRESS=172.31.250.20

# --- Web, API and reverse proxy (/opt/agentic-studio/compose.app.yaml) ---
# The production images, built from apps/api/Dockerfile and apps/web/Dockerfile (deployment.md,
# "Production images"), e.g. registry.example.com/agentic-studio-api:<tag>. While either is empty,
# only PostgreSQL and Redis are started.
STUDIO_API_IMAGE=
STUDIO_WEB_IMAGE=
# Required with the images. The public domain of the web app, e.g. studio.example.com: the
# reverse proxy serves https://<STUDIO_DOMAIN> on ports 80 and 443, the only host ports, and the
# API accepts mutations only from that origin.
STUDIO_DOMAIN=
# Required with the images. TLS for STUDIO_DOMAIN: the ACME account email for a public
# certificate (the domain must point at this server, ports 80 and 443 reachable), or `internal`
# for Caddy's own CA (tests only: browsers do not trust it).
STUDIO_TLS=

# --- API (read inside the API container) ---
# API_HOST, API_PORT, STUDIO_DATA_DIR, STUDIO_ORIGIN (https://<STUDIO_DOMAIN>) and
# API_TRUSTED_PROXIES (the reverse proxy's address, STUDIO_PROXY_ADDRESS, never the network's
# gateway) are set by compose.app.yaml; values here are ignored.
# Required. Must match POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB above; the host is the
# Compose service name:
#   postgresql://studio:<POSTGRES_PASSWORD>@postgres:5432/agentic_studio
DATABASE_URL=
# Required. The same password as REDIS_PASSWORD; the host is the Compose service name:
#   redis://:<REDIS_PASSWORD>@redis:6379
REDIS_URL=
# Required. Argon2id hash of the operator password, in single quotes (README.md, "Operator login").
STUDIO_OPERATOR_PASSWORD_HASH=
# Required. Master key of the secret store: `openssl rand -base64 32`. Back it up off the server,
# separately from the database backups (README.md, "Secrets key").
STUDIO_SECRETS_KEY=
# Required for Runs. The worker token: `openssl rand -base64 32`. Put the same value in the agent
# user's ~/.config/agentic-studio-worker/.env (STUDIO_WORKER_TOKEN) and nowhere else.
STUDIO_WORKER_TOKEN=
STUDIO_SSH_KNOWN_HOSTS=
STUDIO_GIT_ALLOW_PRIVATE_REMOTES=false
STUDIO_WORKER_LEASE_SECONDS=60
STUDIO_RUN_STEP_MINUTES=60
STUDIO_RUN_MAX_STEPS=10
STUDIO_RUN_WAITING_DAYS=14
STUDIO_RUN_MAX_TOTAL_STEPS=50
STUDIO_RUN_LOG_MAX_BYTES=8388608
STUDIO_RUN_SNAPSHOT_RETENTION_DAYS=7
