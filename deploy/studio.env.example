# Studio's server configuration (Issue #107, docs/engineering/deployment.md). The setup script
# copies this template to /etc/agentic-studio/.env (root, 0600) when that file does not exist yet
# and never overwrites it. It writes no secret: the empty values below are filled in by the
# operator, as root, on the server. Never commit a filled-in copy.

# --- Compose (/opt/agentic-studio/compose.yaml) ---
COMPOSE_PROJECT_NAME=agentic-studio
POSTGRES_DB=agentic_studio
POSTGRES_USER=studio
# Required. The database password, used only inside Studio's container network:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
# Studio's container network and the fixed addresses of PostgreSQL and Redis on it. The setup
# script's firewall rule blocks the agent user from this subnet (except the API port), and the
# boundary checks probe these addresses. Change them only together with the matching settings at
# the top of setup-server.sh and check-boundary.sh.
STUDIO_NETWORK_SUBNET=172.31.250.0/24
STUDIO_POSTGRES_ADDRESS=172.31.250.10
STUDIO_REDIS_ADDRESS=172.31.250.11

# --- Web and API images (/opt/agentic-studio/compose.app.yaml) ---
# Empty until Studio has production images (deployment.md, "Known gaps"); while empty, only
# PostgreSQL and Redis are started.
STUDIO_API_IMAGE=
STUDIO_WEB_IMAGE=
# Host ports, bound to 127.0.0.1 for the reverse proxy. Nothing else is published.
API_PORT=3001
WEB_PORT=3000

# --- API (read inside the API container) ---
# Required. Must match POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB above; the host is the
# Compose service name:
#   postgresql://studio:<POSTGRES_PASSWORD>@postgres:5432/agentic_studio
DATABASE_URL=
REDIS_URL=redis://redis:6379
# The public https origin of the web app behind the reverse proxy (a placeholder).
STUDIO_ORIGIN=https://studio.example.com
# The address the reverse proxy's requests arrive from inside the container network (the
# network's gateway when the proxy runs on the host), so login rate limits see real clients.
API_TRUSTED_PROXIES=172.31.250.1
# Required. Argon2id hash of the operator password, in single quotes (README.md, "Operator login").
STUDIO_OPERATOR_PASSWORD_HASH=
# Required. Master key of the secret store: `openssl rand -base64 32`. Back it up off the server,
# separately from the database backups (README.md, "Secrets key").
STUDIO_SECRETS_KEY=
# Required for Runs. The worker token: `openssl rand -base64 32`. Put the same value in the agent
# user's ~/.config/agentic-studio-worker/.env (STUDIO_WORKER_TOKEN) and nowhere else.
STUDIO_WORKER_TOKEN=
STUDIO_SSH_KNOWN_HOSTS=
STUDIO_GIT_ALLOW_PRIVATE_REMOTES=false
STUDIO_WORKER_LEASE_SECONDS=60
STUDIO_RUN_STEP_MINUTES=60
STUDIO_RUN_MAX_STEPS=10
STUDIO_RUN_WAITING_DAYS=14
STUDIO_RUN_LOG_MAX_BYTES=8388608
STUDIO_RUN_SNAPSHOT_RETENTION_DAYS=7
