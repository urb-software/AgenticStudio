{
  "name": "@agentic-studio/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "default": "./dist/migrations.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "pnpm run generate && tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "pnpm run generate && tsc --noEmit -p tsconfig.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  }
}
