// Canonical Prisma schema for AI Agent Studio.
// Business models are added by the slices that own them;
// the connection URL lives in prisma.config.ts, not here (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A project the operator manages (`projects` business module, Story #16).
model Project {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Display name: trimmed, internal whitespace collapsed, case preserved (1–100 characters).
  name           String   @db.VarChar(100)
  /// `name` lower-cased; unique, so names clash case-insensitively (Epic #8 decision 2).
  /// Unbounded: lower-casing can lengthen a string (e.g. "İ" becomes two code points).
  nameNormalized String   @unique(map: "projects_name_normalized_key") @map("name_normalized")
  /// Set by PostgreSQL (microsecond precision), not by the client, so ordering uses one clock.
  createdAt      DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)

  /// Serves the newest-first list (created_at DESC, id DESC as the tie-breaker).
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "projects_created_at_id_idx")
  @@map("projects")
}

/// One value sealed by the API's SecretStore (`platform/secrets`, Issue #57, ADR 0001):
/// AES-256-GCM under the master key `STUDIO_SECRETS_KEY`, which never enters the database.
/// Business tables hold only the `id` as an opaque reference, never a secret value.
/// The migration adds CHECK constraints (12-byte nonce, 16-byte tag, key_version >= 1),
/// which Prisma does not model.
model Secret {
  /// The reference. Generated by the API: it is bound to the ciphertext as AES-GCM additional
  /// authenticated data, so a sealed value copied into another row fails to decrypt.
  id         String   @id @db.Uuid
  ciphertext Bytes
  /// 12 random bytes, fresh for every sealed value.
  nonce      Bytes
  /// The 16-byte GCM authentication tag.
  authTag    Bytes    @map("auth_tag")
  /// The master key that sealed this row; starts at 1 so a rotation can be added later.
  keyVersion Int      @map("key_version")
  createdAt  DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)

  @@map("secrets")
}
