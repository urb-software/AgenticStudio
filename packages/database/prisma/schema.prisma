// Canonical Prisma schema for AI Agent Studio.
// Business models are added by the slices that own them;
// the connection URL lives in prisma.config.ts, not here (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A project the operator manages (`projects` business module, Story #16).
model Project {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Display name: trimmed, internal whitespace collapsed, case preserved (1–100 characters).
  name            String           @db.VarChar(100)
  /// `name` lower-cased; unique, so names clash case-insensitively (Epic #8 decision 2).
  /// Unbounded: lower-casing can lengthen a string (e.g. "İ" becomes two code points).
  nameNormalized  String           @unique(map: "projects_name_normalized_key") @map("name_normalized")
  /// Set by PostgreSQL (microsecond precision), not by the client, so ordering uses one clock.
  createdAt       DateTime         @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)
  /// The connected Repository (Story #60): at most one per project.
  repository      Repository?
  /// The project's Runs (`executions` module, Issue #96).
  runs            Run[]
  /// The project's Environment file setting (Issue #104), independent of the Repository.
  environmentFile EnvironmentFile?

  /// Serves the newest-first list (created_at DESC, id DESC as the tie-breaker).
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "projects_created_at_id_idx")
  @@map("projects")
}

/// The Git repository connected to a project (`projects` module, Story #60), one per project.
/// The migration adds CHECK constraints (the known states; failure fields set exactly when
/// `failed`), which Prisma does not model. `state` and `failure_code` are text, not enums, so
/// later stories add values by changing a CHECK constraint.
model Repository {
  /// The owning project; also the primary key, so a project has at most one repository.
  projectId                  String    @id @map("project_id") @db.Uuid
  project                    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The URL as the operator entered it (trimmed).
  url                        String    @db.VarChar(2048)
  /// Host plus path without scheme, user, port, trailing slash or `.git`: the same remote in
  /// any URL form. Unique, so one remote cannot be connected to two projects.
  urlNormalized              String    @unique(map: "repositories_url_normalized_key") @map("url_normalized")
  integrationBranch          String    @map("integration_branch") @db.VarChar(255)
  /// awaiting_key | awaiting_host_key | connecting | ready | fetching | failed | disconnecting.
  state                      String    @db.VarChar(32)
  /// Commit id of the integration branch in the Clone; set exactly while a usable Clone exists
  /// (always when ready or fetching; kept by a failed fetch, cleared when it removes the Clone).
  headSha                    String?   @map("head_sha") @db.VarChar(64)
  /// When the Clone was last brought up to date; set exactly when head_sha is.
  lastFetchedAt              DateTime? @map("last_fetched_at") @db.Timestamptz(6)
  /// One of the fixed failure reason codes; set exactly when failed.
  failureCode                String?   @map("failure_code") @db.VarChar(32)
  /// Redacted Git output or a short fixed explanation; set exactly when failed.
  failureDetail              String?   @map("failure_detail") @db.VarChar(2000)
  /// For branch_not_found: the remote's default branch, when it advertises one.
  failureRemoteDefaultBranch String?   @map("failure_remote_default_branch") @db.VarChar(255)
  /// SSH only (Story #62): the secret store's reference to the Deploy key's private half (an
  /// opaque `secrets.id`, no foreign key: secrets belong to platform/secrets). Never the key.
  deployKeySecretId          String?   @map("deploy_key_secret_id") @db.Uuid
  /// SSH only: the Deploy key's public half, one OpenSSH line; set exactly with the reference.
  publicKey                  String?   @map("public_key") @db.VarChar(1024)
  /// SSH only: the host key the operator confirmed, pinned for this repository.
  pinnedHostKey              String?   @map("pinned_host_key") @db.VarChar(8192)
  /// The retrieved host key awaiting confirmation; set exactly when awaiting_host_key.
  pendingHostKey             String?   @map("pending_host_key") @db.VarChar(8192)
  createdAt                  DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz(6)

  @@map("repositories")
}

/// A project's Environment file (`projects` module, Issue #104): a file of test settings Studio
/// places in each Run's Working copy. The content lives in the secret store; this row holds its
/// reference and what the operator may see (path, size, last change). It survives
/// disconnecting the Repository. The migration adds CHECK constraints (size 0-65536, non-empty
/// path), which Prisma does not model.
model EnvironmentFile {
  /// The owning project; also the primary key, so a project has at most one.
  projectId String   @id @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Relative POSIX path in the repository, validated by the API.
  path      String   @db.VarChar(255)
  /// UTF-8 bytes of the content.
  sizeBytes Int      @map("size_bytes")
  /// The secret store's reference to the content (an opaque `secrets.id`, no foreign key:
  /// secrets belong to platform/secrets). Never the content.
  secretId  String   @map("secret_id") @db.Uuid
  updatedAt DateTime @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz(6)

  @@map("environment_files")
}

/// One value sealed by the API's SecretStore (`platform/secrets`, Issue #57, ADR 0001):
/// AES-256-GCM under the master key `STUDIO_SECRETS_KEY`, which never enters the database.
/// Business tables hold only the `id` as an opaque reference, never a secret value.
/// The migrations add CHECK constraints (12-byte nonce, 16-byte tag, key_version >= 1, the
/// owner label's format), which Prisma does not model.
model Secret {
  /// The reference. Generated by the API: it is bound to the ciphertext as AES-GCM additional
  /// authenticated data, so a sealed value copied into another row fails to decrypt.
  id         String   @id @db.Uuid
  ciphertext Bytes
  /// 12 random bytes, fresh for every sealed value.
  nonce      Bytes
  /// The 16-byte GCM authentication tag.
  authTag    Bytes    @map("auth_tag")
  /// The master key that sealed this row; starts at 1 so a rotation can be added later.
  keyVersion Int      @map("key_version")
  /// The business module's label the value was stored under (e.g. `projects.deploy-key`,
  /// Issue #76), so a module can find its own unreferenced secrets. Not secret. Rows from
  /// before the label existed are all `projects.deploy-key` (the only secret stored then).
  owner      String   @db.VarChar(64)
  createdAt  DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)

  /// Serves listing one owner's secrets older than an age.
  @@index([owner, createdAt], map: "secrets_owner_created_at_idx")
  @@map("secrets")
}

/// A Run (`executions` module, Issue #96): one Task carried out by a Provider on one Project,
/// starting from a recorded commit of the integration branch. The migration adds CHECK
/// constraints (known states, providers and failure codes; fields that go with a state) and a
/// partial unique index, which Prisma does not model. `state`, `provider` and `failure_code` are
/// text, so later stories add values by changing a CHECK.
///
/// Never drop `runs_one_active_per_project_key` (UNIQUE (project_id) WHERE state IN ('preparing',
/// 'running', 'waiting_for_operator')): it is the schema-level backstop of the concurrency limit
/// (one active Run per project), and like the CHECKs it lives only in
/// migrations/20261115000000_create_runs/migration.sql. Prisma 7.10 proposes no drop of it or of the
/// CHECKs (the database integration test checks this). If a later version does, delete that
/// statement from the generated migration before committing it.
model Run {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The owning project. Restrict: a project with Runs cannot be deleted silently.
  projectId               String       @map("project_id") @db.Uuid
  project                 Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// claude_code | codex.
  provider                String       @db.VarChar(32)
  /// The operator's instruction (1–20 000 characters).
  task                    String       @db.VarChar(20000)
  /// queued | preparing | running | waiting_for_operator | succeeded | failed | cancelled | timed_out.
  state                   String       @db.VarChar(32)
  /// The integration branch's commit when the Run was started.
  startCommit             String       @map("start_commit") @db.VarChar(64)
  /// The Repository's remote URL when the Run was started (Issue #98); the agent worker fetches
  /// the start commit from it with the agent user's own credentials. Never a credential.
  remoteUrl               String       @map("remote_url") @db.VarChar(2048)
  /// The Run branch in the Working copy, from the latest reported Run step (Issue #98); set
  /// together with commits and has_uncommitted_changes.
  runBranch               String?      @map("run_branch") @db.VarChar(255)
  /// The commits on the Run branch since the start commit, `[{ id, subject }]`, oldest first,
  /// as the worker protocol validated them.
  commits                 Json?
  /// Whether uncommitted changes remained in the Working copy after the latest Run step.
  hasUncommittedChanges   Boolean?     @map("has_uncommitted_changes")
  /// The Repository's integration branch when the Run was started (Issue #102): the base of
  /// the Run's draft pull request.
  integrationBranch       String       @map("integration_branch") @db.VarChar(255)
  /// none | delivered (with succeeded) | failed (with failed and delivery_failed); null until
  /// the Run is delivered or its delivery fails (Issue #102).
  delivery                String?      @db.VarChar(16)
  /// The draft pull request the delivery opened or reused; set exactly when delivered.
  pullRequestUrl          String?      @map("pull_request_url") @db.VarChar(2048)
  pullRequestNumber       Int?         @map("pull_request_number")
  /// The operator asked to retry a failed delivery; the next claim hands the Run to an agent
  /// worker as a delivery, and the worker holds it (claimed_by) until it reports the outcome.
  deliveryRequested       Boolean      @default(false) @map("delivery_requested")
  /// Names of the checks the agent reported failed in the latest Run step, `["..."]`.
  failingChecks           Json?        @map("failing_checks")
  /// The agent worker that claimed the Run to start it: only it holds the Working copy, so a
  /// delivery retry is handed to it alone (review R4 of #122).
  lastClaimedBy           String?      @map("last_claimed_by") @db.Uuid
  /// Set by PostgreSQL, so the queue order (created_at, id) uses one clock.
  createdAt               DateTime     @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)
  /// When an agent worker claimed the Run.
  startedAt               DateTime?    @map("started_at") @db.Timestamptz(6)
  /// When the Run reached a final state.
  finishedAt              DateTime?    @map("finished_at") @db.Timestamptz(6)
  /// One of the fixed failure codes; set exactly when failed.
  failureCode             String?      @map("failure_code") @db.VarChar(32)
  /// A short explanation; set exactly when failed. Never a secret.
  failureDetail           String?      @map("failure_detail") @db.VarChar(2000)
  /// The agent worker holding the Run (its random id); set exactly when preparing or running.
  claimedBy               String?      @map("claimed_by") @db.Uuid
  /// The holding worker's last heartbeat; set exactly when claimed_by is.
  heartbeatAt             DateTime?    @map("heartbeat_at") @db.Timestamptz(6)
  /// Issue #100: when the operator asked to cancel a preparing or running Run; the worker
  /// confirms the stop with the state cancelled.
  cancelRequestedAt       DateTime?    @map("cancel_requested_at") @db.Timestamptz(6)
  /// operator | system; set exactly when cancelled, together with cancel_reason.
  cancelledBy             String?      @map("cancelled_by") @db.VarChar(16)
  /// Why the Run was cancelled, shown to the operator.
  cancelReason            String?      @map("cancel_reason") @db.VarChar(500)
  /// When the Run began waiting for the operator; set exactly when waiting_for_operator.
  waitingSince            DateTime?    @map("waiting_since") @db.Timestamptz(6)
  /// The limits copied from the API's configuration when the Run was started (Issue #100).
  limitStepMinutes        Int          @map("limit_step_minutes")
  limitMaxSteps           Int          @map("limit_max_steps")
  limitWaitingDays        Int          @map("limit_waiting_days")
  /// When the current Run step started; set whenever the Run goes to running and cleared when
  /// its result is reported (review of #121: Studio's backstop for the step time limit).
  stepStartedAt           DateTime?    @map("step_started_at") @db.Timestamptz(6)
  /// The agent worker that released the Run (to waiting_for_operator or a final state), so a
  /// retried report of that change is recognised (review of #121).
  releasedBy              String?      @map("released_by") @db.Uuid
  /// UTF-8 bytes of event text stored for the Run (Issue #99), counted against the log cap.
  logBytes                Int          @default(0) @map("log_bytes")
  /// Whether the log cap was reached: one "log truncated" notice is stored, later events are dropped.
  logTruncated            Boolean      @default(false) @map("log_truncated")
  /// Whether the Run was given its Project's Environment file when it was claimed (Issue #104).
  environmentFileSupplied Boolean      @default(false) @map("environment_file_supplied")
  /// That file's path in the Working copy, set exactly when supplied: a delivery (also a retry)
  /// never commits or pushes it (Issue #102's `studioPaths`). Not secret.
  environmentFilePath     String?      @map("environment_file_path") @db.VarChar(255)
  /// The secret store's reference to the Run's snapshot of that file, kept for log redaction
  /// until the Run is final (then deleted and cleared). Never the content.
  environmentFileSecretId String?      @map("environment_file_secret_id") @db.Uuid
  /// The agent session the last Run step reported (Issue #103): an answer resumes it. Internal:
  /// sent only to the agent worker that started the Run, never to the operator API.
  sessionRef              String?      @map("session_ref") @db.VarChar(256)
  /// Issue #141: how many Follow-ups the operator sent to the Run.
  followUpCount           Int          @default(0) @map("follow_up_count")
  /// Issue #141: the Run is queued for a Follow-up its agent worker has not claimed yet. Unlike an
  /// answered Run it holds no place while it waits: it starts under the concurrency limits.
  followUpQueued          Boolean      @default(false) @map("follow_up_queued")
  /// Issue #141: how many Run steps the Run had taken when its current part (the first part or
  /// the latest Follow-up) began; each part gets limit_max_steps Run steps.
  stepsBeforePart         Int          @default(0) @map("steps_before_part")
  /// Issue #141: the most Run steps the Run may take in total before it accepts no Follow-up.
  limitMaxTotalSteps      Int          @default(50) @map("limit_max_total_steps")
  /// Issue #141: the commit the latest push left the remote Run branch at; the commits up to and
  /// including it are pushed.
  pushedCommit            String?      @map("pushed_commit") @db.VarChar(64)
  /// Issue #141: when the agent worker reported that its retention removed the Working copy.
  workingCopyRemovedAt    DateTime?    @map("working_copy_removed_at") @db.Timestamptz(6)
  /// Issue #142: where the Run's pull request stood when the agent worker last looked
  /// (draft | open | merged | closed | missing); null until the first lookup succeeded. The last
  /// known state is kept when a later lookup fails.
  prState                 String?      @map("pr_state") @db.VarChar(16)
  /// Commits the Run branch is behind / ahead of the integration branch, at that lookup.
  prBehindBy              Int?         @map("pr_behind_by")
  prAheadBy               Int?         @map("pr_ahead_by")
  /// Whether the Git host said the pull request can be merged without conflicts, if it said.
  prMergeable             Boolean?     @map("pr_mergeable")
  /// When that state was read.
  prRefreshedAt           DateTime?    @map("pr_refreshed_at") @db.Timestamptz(6)
  /// Why the latest lookup failed (the worker's words, redacted); cleared by a success.
  prRefreshError          String?      @map("pr_refresh_error") @db.VarChar(500)
  /// A rate-limited lookup is tried again at this time; cleared by a success.
  prRetryAt               DateTime?    @map("pr_retry_at") @db.Timestamptz(6)
  /// Set while a pull request lookup of the Run waits for a worker or is being answered.
  prRefreshRequestedAt    DateTime?    @map("pr_refresh_requested_at") @db.Timestamptz(6)
  /// When a lookup of the Run's pull request was last requested (review S1 of #152): the page-open
  /// throttle and the daily refresh count from the last attempt, whether or not it succeeded.
  prLastAttemptAt         DateTime?    @map("pr_last_attempt_at") @db.Timestamptz(6)
  /// Issue #145: the Pull request checks of the pull request's latest commit as the last state
  /// lookup read them: `{"commit": "<sha>", "checks": [{name, state, durationSeconds?, url}]}`, or
  /// `{"unavailable": true}` when the Git host refused to tell. Null until read, and for a pull
  /// request that is merged, closed or missing.
  prChecks                Json?        @map("pr_checks")
  /// Issue #145: set while a failing-check-logs lookup of the Run waits for a worker or is being
  /// answered ("Send failing checks to the agent" was asked, the draft is not ready).
  prPrepareRequestedAt    DateTime?    @map("pr_prepare_requested_at") @db.Timestamptz(6)
  /// Issue #145: why the latest preparation failed (the worker's words, redacted); cleared when
  /// a new one is requested or succeeds.
  prPrepareError          String?      @map("pr_prepare_error") @db.VarChar(500)
  preparedFollowUp        RunPreparedFollowUp?
  /// Issue #146: the pull request's Review comments as the last load read them (at most one set
  /// per Run, replaced by each load).
  reviewCommentSet        RunReviewCommentSet?
  /// Issue #143: when a lookup first reported the pull request merged, closed or missing; cleared
  /// when a later one reports it open or draft again. Set only with such a pr_state.
  prEndedAt               DateTime?    @map("pr_ended_at") @db.Timestamptz(6)
  /// Issue #143: when the Run last had activity (a Run step, an Answer or a Follow-up); starts at
  /// creation. Working copy retention counts the idle time from here.
  lastActivityAt          DateTime     @default(dbgenerated("now()")) @map("last_activity_at") @db.Timestamptz(6)
  steps                   RunStep[]
  events                  RunEvent[]
  messages                RunMessage[]
  diffs                   RunDiff[]
  diffState               RunDiffState?
  lookups                 RunLookup[]

  /// Serves the newest-first list of all Runs.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "runs_created_at_id_idx")
  /// Serves the newest-first list of a project's Runs.
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)], map: "runs_project_id_created_at_id_idx")
  /// Serves the claim (oldest queued first) and the lost-worker sweep.
  @@index([state, createdAt, id], map: "runs_state_created_at_id_idx")
  @@map("runs")
}

/// The reported result of one Run step (Issue #96): internal, not in the operator contract yet.
model RunStep {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// 1, 2, … within the Run, in report order.
  index     Int
  /// start | resume.
  kind      String   @db.VarChar(16)
  /// The structured result as the worker reported it (validated by the shared contract).
  result    Json
  createdAt DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)

  @@unique([runId, index], map: "run_steps_run_id_index_key")
  @@map("run_steps")
}

/// One turn of a Run's conversation after its Task (Issue #103): the agent's question from a
/// needs_input Run step, or the operator's answer to it, in order.
model RunMessage {
  runId          String   @map("run_id") @db.Uuid
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// 1, 2, … within the Run, in order.
  seq            Int
  /// question | answer | follow_up | part_end (Issue #141).
  kind           String   @db.VarChar(16)
  /// The question's text (redacted, the agent's), the operator's answer or Follow-up.
  text           String
  /// A question's options, `["..."]`, when the agent offered any.
  options        Json?
  /// The option a question recommends, when it recommends one.
  recommendation String?
  /// When the question was reported or the answer given.
  at             DateTime @db.Timestamptz(6)
  /// With part_end only (review S1 of #150): the state the part before a Follow-up ended in.
  endState       String?  @map("end_state") @db.VarChar(32)
  /// With part_end only: that part's failure code, when it failed.
  endFailureCode String?  @map("end_failure_code") @db.VarChar(32)
  /// With part_end only: that part's delivery (none | delivered | failed), when it had one.
  endDelivery    String?  @map("end_delivery") @db.VarChar(16)
  /// With follow_up only (Issue #145): what the Follow-up was prepared from (pull_request_checks);
  /// null for one the operator wrote from scratch.
  source         String?  @db.VarChar(32)
  /// With source review_comments only (Issue #146): how many Review comments the Follow-up was
  /// prepared from, and the logins of their authors (distinct, at most 20).
  sourceCount    Int?     @map("source_count")
  sourceAuthors  String[] @default([]) @map("source_authors")

  @@id([runId, seq], map: "run_messages_pkey")
  @@map("run_messages")
}

/// The Follow-up Studio prepared for the operator to review (Issue #145): at most one per Run, the
/// latest preparation replaces the earlier one. It is never sent by itself: sending is the normal
/// Follow-up, with the text the operator left in the preview, after which the draft is removed.
/// Shared with the story that prepares one from review comments (`source` tells them apart).
model RunPreparedFollowUp {
  runId     String   @id @map("run_id") @db.Uuid
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// pull_request_checks (later stories add sources).
  source    String   @db.VarChar(32)
  /// The prepared text (redacted, at most the Follow-up's length).
  text      String
  /// What the text was built from, `[{name, url, logAvailable, section}]`: the parts the
  /// operator can leave out.
  items     Json
  createdAt DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)

  @@map("run_prepared_follow_ups")
}

/// The pull request's Review comments as an agent worker loaded them (Issue #146): at most one set
/// per Run, replaced by each load, removed when a Follow-up prepared from it is sent. The comments
/// are untrusted text from the Git host (redacted, capped): `[{id, author, kind, path?, line?,
/// diffContext?, verdict?, text, textCut?, createdAt}]`, validated by the shared contract on read.
model RunReviewCommentSet {
  runId     String   @id @map("run_id") @db.Uuid
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// since_last_result | unresolved.
  scope     String   @db.VarChar(16)
  comments  Json
  /// More comments existed, or a text was cut to its limit.
  truncated Boolean
  loadedAt  DateTime @map("loaded_at") @db.Timestamptz(6)

  @@map("run_review_comment_sets")
}

/// A question for the Git host that only an agent worker can answer (Issue #142), e.g. the state
/// of the Run's pull request. Studio records the request, any connected worker claims it and
/// reports the result. At most one open (requested or claimed) lookup per Run and kind.
model RunLookup {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId       String    @map("run_id") @db.Uuid
  run         Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// pull_request_state | failing_check_logs | review_comments (later stories add kinds).
  kind        String    @db.VarChar(32)
  /// requested | claimed | done | failed.
  status      String    @db.VarChar(16)
  requestedAt DateTime  @default(dbgenerated("now()")) @map("requested_at") @db.Timestamptz(6)
  /// The worker holding a claimed lookup, and since when (a lease of two minutes).
  claimedBy   String?   @map("claimed_by") @db.Uuid
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  /// The worker's result as validated by the shared contract; set with done.
  result      Json?
  /// Why it failed (redacted); set with failed, and with a retry scheduled.
  error       String?   @db.VarChar(500)
  /// A requested lookup that was rate limited is not handed out before this time.
  retryAt     DateTime? @map("retry_at") @db.Timestamptz(6)
  /// review_comments only (Issue #146): since_last_result | unresolved, and for the first the time
  /// after which a comment counts as new (the end of the Run's latest part).
  scope       String?   @db.VarChar(16)
  since       DateTime? @db.Timestamptz(6)

  @@index([status, requestedAt], map: "run_lookups_status_requested_at_idx")
  @@index([runId], map: "run_lookups_run_id_idx")
  @@map("run_lookups")
}

/// One event of a Run's log (Issue #99): the durable record; the live stream is built on it.
/// Text is redacted and capped before it is stored.
model RunEvent {
  runId     String   @map("run_id") @db.Uuid
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The worker's sequence number, per Run, from 1; a re-sent event with a stored seq is ignored.
  seq       Int
  /// When the worker saw the event.
  at        DateTime @db.Timestamptz(6)
  /// The Run step the event belongs to: 1, 2, …
  stepIndex Int      @map("step_index")
  /// message | command | output | step_started | step_finished | notice.
  kind      String   @db.VarChar(16)
  text      String
  /// The text was cut to the per-event cap.
  truncated Boolean  @default(false)

  @@id([runId, seq], map: "run_events_pkey")
  @@map("run_events")
}

/// A Run's latest diff of one scope (Issue #144): `run` (from the start commit) or `last` (since
/// the previous result), as the agent worker reported it after a Run step's result. Replaced by
/// the next report; kept after the Working copy is removed.
model RunDiff {
  runId             String        @map("run_id") @db.Uuid
  run               Run           @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// run | last.
  scope             String        @db.VarChar(8)
  /// The commit the diff starts from; null exactly when the diff could not be computed.
  baseCommit        String?       @map("base_commit") @db.VarChar(64)
  /// Whether the diff includes changes that were not pushed.
  includesUnpushed  Boolean       @default(false) @map("includes_unpushed")
  /// A limit left content or files out.
  truncated         Boolean       @default(false)
  /// The file list `[{ path, previousPath?, status, additions, deletions, binary?, tooLarge?,
  /// hasPatch }]`, in Git's order; the patches are in run_diff_files.
  files             Json
  /// Why the diff could not be computed (the worker's words, redacted); null otherwise.
  unavailableReason String?       @map("unavailable_reason") @db.VarChar(500)
  reportedAt        DateTime      @map("reported_at") @db.Timestamptz(6)
  patches           RunDiffFile[]

  @@id([runId, scope], map: "run_diffs_pkey")
  @@map("run_diffs")
}

/// One file's patch in a Run's diff (Issue #144): Git's unified diff text, redacted like the log.
/// Keyed by the file's position in the diff's file list (a path may be too long for an index).
model RunDiffFile {
  runId    String  @map("run_id") @db.Uuid
  scope    String  @db.VarChar(8)
  diff     RunDiff @relation(fields: [runId, scope], references: [runId, scope], onDelete: Cascade)
  /// 0, 1, … in the order of run_diffs.files.
  position Int
  path     String
  patch    String

  @@id([runId, scope, position], map: "run_diff_files_pkey")
  @@map("run_diff_files")
}

/// Where a Run's diffs stand (Issue #144, review S-1 of #149): the snapshot trees and commits of
/// the latest and the previous result, and the Run branch tip the worker last pushed. Studio
/// keeps it for the agent worker and hands it back with a resume or delivery claim.
model RunDiffState {
  runId          String  @id @map("run_id") @db.Uuid
  run            Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  resultTree     String  @map("result_tree") @db.VarChar(64)
  resultCommit   String  @map("result_commit") @db.VarChar(64)
  previousTree   String  @map("previous_tree") @db.VarChar(64)
  previousCommit String  @map("previous_commit") @db.VarChar(64)

  @@map("run_diff_states")
}

/// When the API last renewed the leases of held Runs at start (review of #121): at most once per
/// lease period, so an API crash loop cannot keep a dead worker's Run alive. One row.
model RunLeaseRenewal {
  id        Int      @id @db.SmallInt
  renewedAt DateTime @map("renewed_at") @db.Timestamptz(6)

  @@map("run_lease_renewals")
}
