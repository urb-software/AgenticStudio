// Canonical Prisma schema for AI Agent Studio.
// Business models are added by the slices that own them;
// the connection URL lives in prisma.config.ts, not here (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A project the operator manages (`projects` business module, Story #16).
model Project {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Display name: trimmed, internal whitespace collapsed, case preserved (1–100 characters).
  name           String      @db.VarChar(100)
  /// `name` lower-cased; unique, so names clash case-insensitively (Epic #8 decision 2).
  /// Unbounded: lower-casing can lengthen a string (e.g. "İ" becomes two code points).
  nameNormalized String      @unique(map: "projects_name_normalized_key") @map("name_normalized")
  /// Set by PostgreSQL (microsecond precision), not by the client, so ordering uses one clock.
  createdAt      DateTime    @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)
  /// The connected Repository (Story #60): at most one per project.
  repository     Repository?
  /// The project's Runs (`executions` module, Issue #96).
  runs           Run[]

  /// Serves the newest-first list (created_at DESC, id DESC as the tie-breaker).
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "projects_created_at_id_idx")
  @@map("projects")
}

/// The Git repository connected to a project (`projects` module, Story #60), one per project.
/// The migration adds CHECK constraints (the known states; failure fields set exactly when
/// `failed`), which Prisma does not model. `state` and `failure_code` are text, not enums, so
/// later stories add values by changing a CHECK constraint.
model Repository {
  /// The owning project; also the primary key, so a project has at most one repository.
  projectId                  String    @id @map("project_id") @db.Uuid
  project                    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The URL as the operator entered it (trimmed).
  url                        String    @db.VarChar(2048)
  /// Host plus path without scheme, user, port, trailing slash or `.git`: the same remote in
  /// any URL form. Unique, so one remote cannot be connected to two projects.
  urlNormalized              String    @unique(map: "repositories_url_normalized_key") @map("url_normalized")
  integrationBranch          String    @map("integration_branch") @db.VarChar(255)
  /// awaiting_key | awaiting_host_key | connecting | ready | fetching | failed | disconnecting.
  state                      String    @db.VarChar(32)
  /// Commit id of the integration branch in the Clone; set exactly while a usable Clone exists
  /// (always when ready or fetching; kept by a failed fetch, cleared when it removes the Clone).
  headSha                    String?   @map("head_sha") @db.VarChar(64)
  /// When the Clone was last brought up to date; set exactly when head_sha is.
  lastFetchedAt              DateTime? @map("last_fetched_at") @db.Timestamptz(6)
  /// One of the fixed failure reason codes; set exactly when failed.
  failureCode                String?   @map("failure_code") @db.VarChar(32)
  /// Redacted Git output or a short fixed explanation; set exactly when failed.
  failureDetail              String?   @map("failure_detail") @db.VarChar(2000)
  /// For branch_not_found: the remote's default branch, when it advertises one.
  failureRemoteDefaultBranch String?   @map("failure_remote_default_branch") @db.VarChar(255)
  /// SSH only (Story #62): the secret store's reference to the Deploy key's private half (an
  /// opaque `secrets.id`, no foreign key: secrets belong to platform/secrets). Never the key.
  deployKeySecretId          String?   @map("deploy_key_secret_id") @db.Uuid
  /// SSH only: the Deploy key's public half, one OpenSSH line; set exactly with the reference.
  publicKey                  String?   @map("public_key") @db.VarChar(1024)
  /// SSH only: the host key the operator confirmed, pinned for this repository.
  pinnedHostKey              String?   @map("pinned_host_key") @db.VarChar(8192)
  /// The retrieved host key awaiting confirmation; set exactly when awaiting_host_key.
  pendingHostKey             String?   @map("pending_host_key") @db.VarChar(8192)
  createdAt                  DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz(6)

  @@map("repositories")
}

/// One value sealed by the API's SecretStore (`platform/secrets`, Issue #57, ADR 0001):
/// AES-256-GCM under the master key `STUDIO_SECRETS_KEY`, which never enters the database.
/// Business tables hold only the `id` as an opaque reference, never a secret value.
/// The migrations add CHECK constraints (12-byte nonce, 16-byte tag, key_version >= 1, the
/// owner label's format), which Prisma does not model.
model Secret {
  /// The reference. Generated by the API: it is bound to the ciphertext as AES-GCM additional
  /// authenticated data, so a sealed value copied into another row fails to decrypt.
  id         String   @id @db.Uuid
  ciphertext Bytes
  /// 12 random bytes, fresh for every sealed value.
  nonce      Bytes
  /// The 16-byte GCM authentication tag.
  authTag    Bytes    @map("auth_tag")
  /// The master key that sealed this row; starts at 1 so a rotation can be added later.
  keyVersion Int      @map("key_version")
  /// The business module's label the value was stored under (e.g. `projects.deploy-key`,
  /// Issue #76), so a module can find its own unreferenced secrets. Not secret. Rows from
  /// before the label existed are all `projects.deploy-key` (the only secret stored then).
  owner      String   @db.VarChar(64)
  createdAt  DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)

  /// Serves listing one owner's secrets older than an age.
  @@index([owner, createdAt], map: "secrets_owner_created_at_idx")
  @@map("secrets")
}

/// A Run (`executions` module, Issue #96): one Task carried out by a Provider on one Project,
/// starting from a recorded commit of the integration branch. The migration adds CHECK
/// constraints (known states, providers and failure codes; fields that go with a state) and a
/// partial unique index, which Prisma does not model. `state`, `provider` and `failure_code` are
/// text, so later stories add values by changing a CHECK.
///
/// Never drop `runs_one_active_per_project_key` (UNIQUE (project_id) WHERE state IN ('preparing',
/// 'running', 'waiting_for_operator')): it is the schema-level backstop of the concurrency limit
/// (one active Run per project), and like the CHECKs it lives only in
/// migrations/20261115000000_create_runs/migration.sql. Prisma 7.10 proposes no drop of it or of the
/// CHECKs (the database integration test checks this). If a later version does, delete that
/// statement from the generated migration before committing it.
model Run {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The owning project. Restrict: a project with Runs cannot be deleted silently.
  projectId             String    @map("project_id") @db.Uuid
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// claude_code | codex.
  provider              String    @db.VarChar(32)
  /// The operator's instruction (1–20 000 characters).
  task                  String    @db.VarChar(20000)
  /// queued | preparing | running | waiting_for_operator | succeeded | failed | cancelled | timed_out.
  state                 String    @db.VarChar(32)
  /// The integration branch's commit when the Run was started.
  startCommit           String    @map("start_commit") @db.VarChar(64)
  /// The Repository's remote URL when the Run was started (Issue #98); the agent worker fetches
  /// the start commit from it with the agent user's own credentials. Never a credential.
  remoteUrl             String    @map("remote_url") @db.VarChar(2048)
  /// The Run branch in the Working copy, from the latest reported Run step (Issue #98); set
  /// together with commits and has_uncommitted_changes.
  runBranch             String?   @map("run_branch") @db.VarChar(255)
  /// The commits on the Run branch since the start commit, `[{ id, subject }]`, oldest first,
  /// as the worker protocol validated them.
  commits               Json?
  /// Whether uncommitted changes remained in the Working copy after the latest Run step.
  hasUncommittedChanges Boolean?  @map("has_uncommitted_changes")
  /// The Repository's integration branch when the Run was started (Issue #102): the base of
  /// the Run's draft pull request.
  integrationBranch     String    @map("integration_branch") @db.VarChar(255)
  /// none | delivered (with succeeded) | failed (with failed and delivery_failed); null until
  /// the Run is delivered or its delivery fails (Issue #102).
  delivery              String?   @db.VarChar(16)
  /// The draft pull request the delivery opened or reused; set exactly when delivered.
  pullRequestUrl        String?   @map("pull_request_url") @db.VarChar(2048)
  pullRequestNumber     Int?      @map("pull_request_number")
  /// The operator asked to retry a failed delivery; the next claim hands the Run to an agent
  /// worker as a delivery, and the worker holds it (claimed_by) until it reports the outcome.
  deliveryRequested     Boolean   @default(false) @map("delivery_requested")
  /// Names of the checks the agent reported failed in the latest Run step, `["..."]`.
  failingChecks         Json?     @map("failing_checks")
  /// Set by PostgreSQL, so the queue order (created_at, id) uses one clock.
  createdAt             DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)
  /// When an agent worker claimed the Run.
  startedAt             DateTime? @map("started_at") @db.Timestamptz(6)
  /// When the Run reached a final state.
  finishedAt            DateTime? @map("finished_at") @db.Timestamptz(6)
  /// One of the fixed failure codes; set exactly when failed.
  failureCode           String?   @map("failure_code") @db.VarChar(32)
  /// A short explanation; set exactly when failed. Never a secret.
  failureDetail         String?   @map("failure_detail") @db.VarChar(2000)
  /// The agent worker holding the Run (its random id); set exactly when preparing or running.
  claimedBy             String?   @map("claimed_by") @db.Uuid
  /// The holding worker's last heartbeat; set exactly when claimed_by is.
  heartbeatAt           DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  /// UTF-8 bytes of event text stored for the Run (Issue #99), counted against the log cap.
  logBytes              Int       @default(0) @map("log_bytes")
  /// Whether the log cap was reached: one "log truncated" notice is stored, later events are dropped.
  logTruncated          Boolean   @default(false) @map("log_truncated")
  steps                 RunStep[]
  events                RunEvent[]

  /// Serves the newest-first list of all Runs.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "runs_created_at_id_idx")
  /// Serves the newest-first list of a project's Runs.
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)], map: "runs_project_id_created_at_id_idx")
  /// Serves the claim (oldest queued first) and the lost-worker sweep.
  @@index([state, createdAt, id], map: "runs_state_created_at_id_idx")
  @@map("runs")
}

/// The reported result of one Run step (Issue #96): internal, not in the operator contract yet.
model RunStep {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// 1, 2, … within the Run, in report order.
  index     Int
  /// start | resume.
  kind      String   @db.VarChar(16)
  /// The structured result as the worker reported it (validated by the shared contract).
  result    Json
  createdAt DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)

  @@unique([runId, index], map: "run_steps_run_id_index_key")
  @@map("run_steps")
}

/// One event of a Run's log (Issue #99): the durable record; the live stream is built on it.
/// Text is redacted and capped before it is stored.
model RunEvent {
  runId     String   @map("run_id") @db.Uuid
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The worker's sequence number, per Run, from 1; a re-sent event with a stored seq is ignored.
  seq       Int
  /// When the worker saw the event.
  at        DateTime @db.Timestamptz(6)
  /// The Run step the event belongs to: 1, 2, …
  stepIndex Int      @map("step_index")
  /// message | command | output | step_started | step_finished | notice.
  kind      String   @db.VarChar(16)
  text      String
  /// The text was cut to the per-event cap.
  truncated Boolean  @default(false)

  @@id([runId, seq], map: "run_events_pkey")
  @@map("run_events")
}
