// Canonical Prisma schema for AI Agent Studio.
// Business models are added by the slices that own them;
// the connection URL lives in prisma.config.ts, not here (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A project the operator manages (`projects` business module, Story #16).
model Project {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Display name: trimmed, internal whitespace collapsed, case preserved (1–100 characters).
  name           String   @db.VarChar(100)
  /// `name` lower-cased; unique, so names clash case-insensitively (Epic #8 decision 2).
  /// Unbounded: lower-casing can lengthen a string (e.g. "İ" becomes two code points).
  nameNormalized String   @unique(map: "projects_name_normalized_key") @map("name_normalized")
  /// Set by PostgreSQL (microsecond precision), not by the client, so ordering uses one clock.
  createdAt      DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)
  /// The connected Repository (Story #60): at most one per project.
  repository     Repository?

  /// Serves the newest-first list (created_at DESC, id DESC as the tie-breaker).
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "projects_created_at_id_idx")
  @@map("projects")
}

/// The Git repository connected to a project (`projects` module, Story #60), one per project.
/// The migration adds CHECK constraints (the known states; failure fields set exactly when
/// `failed`), which Prisma does not model. `state` and `failure_code` are text, not enums, so
/// later stories add values by changing a CHECK constraint.
model Repository {
  /// The owning project; also the primary key, so a project has at most one repository.
  projectId                  String    @id @map("project_id") @db.Uuid
  project                    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The URL as the operator entered it (trimmed).
  url                        String    @db.VarChar(2048)
  /// Host plus path without scheme, user, port, trailing slash or `.git`: the same remote in
  /// any URL form. Unique, so one remote cannot be connected to two projects.
  urlNormalized              String    @unique(map: "repositories_url_normalized_key") @map("url_normalized")
  integrationBranch          String    @map("integration_branch") @db.VarChar(255)
  /// connecting | ready | fetching | failed (later stories add values).
  state                      String    @db.VarChar(32)
  /// Commit id of the integration branch in the Clone; set exactly while a usable Clone exists
  /// (always when ready or fetching; kept by a failed fetch, cleared when it removes the Clone).
  headSha                    String?   @map("head_sha") @db.VarChar(64)
  /// When the Clone was last brought up to date; set exactly when head_sha is.
  lastFetchedAt              DateTime? @map("last_fetched_at") @db.Timestamptz(6)
  /// One of the fixed failure reason codes; set exactly when failed.
  failureCode                String?   @map("failure_code") @db.VarChar(32)
  /// Redacted Git output or a short fixed explanation; set exactly when failed.
  failureDetail              String?   @map("failure_detail") @db.VarChar(2000)
  /// For branch_not_found: the remote's default branch, when it advertises one.
  failureRemoteDefaultBranch String?   @map("failure_remote_default_branch") @db.VarChar(255)
  createdAt                  DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz(6)

  @@map("repositories")
}

/// One value sealed by the API's SecretStore (`platform/secrets`, Issue #57, ADR 0001):
/// AES-256-GCM under the master key `STUDIO_SECRETS_KEY`, which never enters the database.
/// Business tables hold only the `id` as an opaque reference, never a secret value.
/// The migration adds CHECK constraints (12-byte nonce, 16-byte tag, key_version >= 1),
/// which Prisma does not model.
model Secret {
  /// The reference. Generated by the API: it is bound to the ciphertext as AES-GCM additional
  /// authenticated data, so a sealed value copied into another row fails to decrypt.
  id         String   @id @db.Uuid
  ciphertext Bytes
  /// 12 random bytes, fresh for every sealed value.
  nonce      Bytes
  /// The 16-byte GCM authentication tag.
  authTag    Bytes    @map("auth_tag")
  /// The master key that sealed this row; starts at 1 so a rotation can be added later.
  keyVersion Int      @map("key_version")
  createdAt  DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(6)

  @@map("secrets")
}
